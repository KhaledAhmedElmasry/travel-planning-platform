# Copy to frontend/.env.local (never commit .env.local).
# Where the NestJS backend runs. The frontend forwards /api and /uploads there (next.config.ts)
# and server-rendered pages call it directly (src/lib/server/backend.ts).
BACKEND_URL=http://localhost:3000

# B5 on-demand revalidation: the backend sends this secret to POST /revalidate. Use the SAME value
# as REVALIDATE_SECRET in backend/.env (any long random string). Without it the cached pages
# (blog post, author page, public itinerary) still refresh every minute.
REVALIDATE_SECRET=
