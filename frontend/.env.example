# Copy to frontend/.env.local (never commit .env.local).
# Where the NestJS backend runs. The frontend forwards /api and /uploads there (next.config.ts)
# and server-rendered pages call it directly (src/lib/server/backend.ts).
BACKEND_URL=http://localhost:3000

# PAY-01: Stripe publishable key (pk_test_..., same Stripe account as STRIPE_SECRET_KEY in
# backend/.env). The card form (Stripe Elements) runs in the browser, so card data never reaches
# our backend. Public by design (NEXT_PUBLIC_): never put the secret key here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
