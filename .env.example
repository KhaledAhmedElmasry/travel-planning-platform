# Copy this file to backend/.env and fill in the values.
# Ask the team leader for the shared values. NEVER commit backend/.env.

# --- Required ---
# Shared MongoDB Atlas connection string (same for the whole team)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/travel_platform?retryWrites=true&w=majority

# Long random strings (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Single platform currency for all prices, payments and refunds (PAY-04, NEW-04)
PLATFORM_CURRENCY=USD

# --- Server ---
PORT=3000
# Frontend origin allowed to send cookies (Milestone 2)
FRONTEND_URL=http://localhost:3001

# --- Seeded admin account (ACC-18) ---
ADMIN_EMAIL=admin@travelplatform.local
ADMIN_PASSWORD=

# --- Stripe test mode (PAY-01..03) ---
STRIPE_SECRET_KEY=sk_test_...
# Personal value: printed by `stripe listen --forward-to localhost:3000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Exchange rates (ITN-18) ---
FXRATES_API_KEY=

# --- BONUS: email via SMTP (GEN-01-B, ACC-02, ACC-07) ---
# Use a test inbox in development (e.g. Mailtrap or Ethereal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
